# Puerto del servidor (Vercel lo ignora, solo para desarrollo local)
PORT=3000

# --- BASE DE DATOS ---
# OPCIÓN A: URL completa (Neon, Supabase u otro cloud PostgreSQL) — usada en producción
DATABASE_URL=postgresql://usuario:contraseña@host/diverty_park?sslmode=require

# OPCIÓN B: variables individuales — usadas en desarrollo local (se ignoran si DATABASE_URL está definida)
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=diverty_park

# Clave secreta para firmar los tokens JWT (usar una cadena larga y aleatoria en producción)
JWT_SECRETO=reemplazar_con_una_clave_secreta_larga

# URL del frontend (para configurar CORS en producción)
FRONTEND_URL=https://tu-proyecto.vercel.app

# --- VERCEL BLOB (almacenamiento de imágenes en la nube) ---
# Obtené este token en Vercel Dashboard → Storage → Blob Store → .env.local
BLOB_READ_WRITE_TOKEN=tu_token_aqui
